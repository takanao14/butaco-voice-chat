FROM golang:1.27-alpine AS backend
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/butako-search ./cmd/butako-search
COPY internal/searchmcp ./internal/searchmcp
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /butako-search ./cmd/butako-search

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -S butako && adduser -S -G butako butako
COPY --from=backend /butako-search /butako-search
USER butako
EXPOSE 8081
ENTRYPOINT ["/butako-search"]
